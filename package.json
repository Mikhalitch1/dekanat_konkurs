{
  "name": "digital-dekanat-concept",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "lint": "eslint config scripts tests apps vitest.config.ts",
    "typecheck": "tsc --noEmit && npm --prefix apps/web run typecheck",
    "test": "vitest run --coverage",
    "import:schedule": "tsx scripts/import-schedule.ts",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:seed": "node --import tsx scripts/db-seed.ts",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "dev": "npm run setup:local && docker compose up --build",
    "start:api": "node --import tsx apps/api/src/server.ts",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix apps/web run build",
    "e2e": "node --import tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "argon2": "^0.44.0",
    "exceljs": "4.4.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "zod": "3.25.76"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Команда проекта «Цифровой деканат будущего»"
}
