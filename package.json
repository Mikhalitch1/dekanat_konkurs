{
  "name": "digital-dekanat-concept",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint config scripts tests vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "import:schedule": "tsx scripts/import-schedule.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "exceljs": "4.4.0",
    "zod": "3.25.76"
  },
  "overrides": { "exceljs": { "unzipper": "0.12.5" } },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
